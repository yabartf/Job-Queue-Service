# Copy to .env for local (non-Docker) runs. Docker Compose sets these itself.
DATABASE_URL=postgresql+asyncpg://jobs:jobs@localhost:5432/jobs
TEST_DATABASE_URL=postgresql+asyncpg://jobs:jobs@localhost:5433/jobs_test

# Dispatch hint and worker liveness. The system runs without it — losing Redis
# costs latency, not correctness.
REDIS_URL=redis://localhost:6379/0
TEST_REDIS_URL=redis://localhost:6379/15

LOG_LEVEL=INFO
MAX_REQUEST_BODY_BYTES=65536

# Worker. WORKER_HEARTBEAT_SECONDS is a third of the lease, so a single missed
# extension still leaves another before it could expire; SHUTDOWN_GRACE_SECONDS
# must stay under the container's stop_grace_period or leases are never released.
WORKER_CONCURRENCY=2
WORKER_LEASE_SECONDS=60
WORKER_HEARTBEAT_SECONDS=20
WORKER_POLL_INTERVAL_SECONDS=5
MAINTENANCE_INTERVAL_SECONDS=5
SHUTDOWN_GRACE_SECONDS=30
